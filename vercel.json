{
  "redirects": [
    {
      "source": "/",
      "destination": "/games",
      "permanent": false
    },
    {
      "source": "/ludonova/:path*",
      "destination": "/games/ludonova",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/games/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/games/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/games/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/games/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/games/sarvimo-icon.png",
      "destination": "/sarvimo-icon.png"
    },
    {
      "source": "/games/icon.svg",
      "destination": "/icon.svg"
    },
    {
      "source": "/games/icon-192.png",
      "destination": "/icon-192.png"
    },
    {
      "source": "/games/icon-512.png",
      "destination": "/icon-512.png"
    },
    {
      "source": "/games/manifest-ludonova.webmanifest",
      "destination": "/manifest-ludonova.webmanifest"
    },
    {
      "source": "/games/manifest-seedhirush.webmanifest",
      "destination": "/manifest-seedhirush.webmanifest"
    },
    {
      "source": "/games/manifest-dhandhaking.webmanifest",
      "destination": "/manifest-dhandhaking.webmanifest"
    },
    {
      "source": "/games/manifest-haathustle.webmanifest",
      "destination": "/manifest-haathustle.webmanifest"
    },
    {
      "source": "/games/manifest-runwayraja.webmanifest",
      "destination": "/manifest-runwayraja.webmanifest"
    },
    {
      "source": "/games/manifest-hawaiadda.webmanifest",
      "destination": "/manifest-hawaiadda.webmanifest"
    },
    {
      "source": "/games/manifest-railwayraja.webmanifest",
      "destination": "/manifest-railwayraja.webmanifest"
    },
    {
      "source": "/games/manifest-metromaker.webmanifest",
      "destination": "/manifest-metromaker.webmanifest"
    },
    {
      "source": "/games/manifest-tapritycoon.webmanifest",
      "destination": "/manifest-tapritycoon.webmanifest"
    },
    {
      "source": "/games/manifest-dabbaexpress.webmanifest",
      "destination": "/manifest-dabbaexpress.webmanifest"
    },
    {
      "source": "/games/manifest-bolbachchan.webmanifest",
      "destination": "/manifest-bolbachchan.webmanifest"
    },
    {
      "source": "/games/manifest-chitrachor.webmanifest",
      "destination": "/manifest-chitrachor.webmanifest"
    },
    {
      "source": "/games/manifest-jhootaseth.webmanifest",
      "destination": "/manifest-jhootaseth.webmanifest"
    },
    {
      "source": "/games/manifest-mandiwars.webmanifest",
      "destination": "/manifest-mandiwars.webmanifest"
    },
    {
      "source": "/games/manifest-rajmahal.webmanifest",
      "destination": "/manifest-rajmahal.webmanifest"
    },
    {
      "source": "/games/manifest-cricketcaptain.webmanifest",
      "destination": "/manifest-cricketcaptain.webmanifest"
    },
    {
      "source": "/games/manifest-kabaddiraid.webmanifest",
      "destination": "/manifest-kabaddiraid.webmanifest"
    },
    {
      "source": "/games/manifest-gutteghar.webmanifest",
      "destination": "/manifest-gutteghar.webmanifest"
    },
    {
      "source": "/games",
      "destination": "/index.html"
    },
    {
      "source": "/games/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
